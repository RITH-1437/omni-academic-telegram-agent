# Secrets are injected at runtime via docker-compose env_file, never baked into the image
.env
.env.*
!.env.example

# Runtime data lives on the mounted volume
data/
*.db
*.db-wal
*.db-shm

# VCS, caches, and local tooling
.git/
.gitignore
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.venv/
venv/
.vscode/
.idea/
.claude/

# Not needed at runtime
tests/
deploy/
*.md
