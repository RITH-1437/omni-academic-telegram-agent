# ==============================================================================
# Telegram Supergroup Year 5 CS Bot - Environment Configuration Template
# ==============================================================================

# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:your_telegram_bot_token_here

# ------------------------------------------------------------------------------
# Prioritized LLM Providers Array
# Priority order: The first provider listed below is tried first.
# If it fails, hits rate-limit, or times out, it instantly fails over to the next.
# Options: openrouter, opencode_zen, gemini
# ------------------------------------------------------------------------------
LLM_PROVIDER_ORDER=openrouter,opencode_zen

# 1. OpenRouter Provider (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# 2. OpenCode Zen Provider
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key_here
OPENCODE_ZEN_BASE_URL=https://api.opencodezen.com/v1
OPENCODE_ZEN_MODEL=gpt-4o-mini

# 3. Direct Google Gemini (Optional fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Storage, Timezone & Rate Limiting
# ------------------------------------------------------------------------------
DATABASE_PATH=data/bot.db
TIMEZONE=Asia/Phnom_Penh
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_FILE_SIZE_BYTES=20971520

# ------------------------------------------------------------------------------
# Telegram Forum Topic Thread IDs
# ------------------------------------------------------------------------------
TOPIC_THREAD_AI=2
TOPIC_THREAD_CLOUD=3
TOPIC_THREAD_DATA_MINING=4
TOPIC_THREAD_IMAGE_PROC=7
TOPIC_THREAD_INFO_SEC=5
TOPIC_THREAD_NET_SEC=6
TOPIC_THREAD_NLP=8
TOPIC_THREAD_IT_PM=9
TOPIC_THREAD_GENERAL=1

# Admin User IDs
ADMIN_USER_IDS=123456789,987654321
